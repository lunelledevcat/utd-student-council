# ==========================================================================================
# เครื่องตัวเอง (npm run preview): คัดลอกไฟล์นี้เป็น .dev.vars แล้วใส่ค่า (.dev.vars ไม่ถูก commit)
# Cloudflare (production): ค่าลับ -> npx wrangler secret put <ชื่อ> · ค่าไม่ลับ -> wrangler.jsonc vars แล้ว npm run deploy
# ดูสถานะทุกค่า + bindings ได้ที่ /admin/setup (เฉพาะ admin, แสดงแค่สถานะ ไม่แสดงค่า)
# ไฟล์นี้สร้างจาก lib/env-spec.ts + messages/th.json ด้วย `npm run env:docs` — แก้ที่ต้นทางแล้วรันใหม่
# ==========================================================================================

# --- APP_SECRET (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: กุญแจลับของแอป ใช้เซ็นโทเคน API อายุสั้น ลิงก์อัปโหลด/พรีวิวรูป และเป็นเกลือตอนแปลง IP เป็นค่าแฮช
# หาจากไหน: สร้างเอง: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" แล้วใส่ด้วย npx wrangler secret put APP_SECRET (เครื่องตัวเองใส่ใน .dev.vars)
# ลิงก์: https://developers.cloudflare.com/workers/configuration/secrets/
# เปิดเผย: ลับ — production: npx wrangler secret put <ชื่อ> · ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ใช้คีย์ชั่วคราวสำหรับ dev | production → อัปโหลดรูปและส่งเสียงถึงสภาไม่ได้ (error)
APP_SECRET=

# --- AUTH_SECRET (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: กุญแจลับของ Auth.js ใช้เข้ารหัสคุกกี้ระหว่างล็อกอิน
# หาจากไหน: สร้างเองแบบเดียวกับ APP_SECRET (คนละค่า) แล้ว npx wrangler secret put AUTH_SECRET
# ลิงก์: https://authjs.dev/getting-started/deployment#auth_secret
# เปิดเผย: ลับ — production: npx wrangler secret put <ชื่อ> · ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ล็อกอินไม่ได้ | production → ล็อกอินไม่ได้
AUTH_SECRET=

# --- AUTH_GOOGLE_ID (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: Client ID ของ OAuth client ใน Google Cloud (ล็อกอินด้วย Google)
# หาจากไหน: Google Cloud Console → APIs & Services → Credentials → OAuth client (Web) → Client ID; เพิ่ม Authorized redirect URI: <SITE_URL>/api/auth/callback/google แล้ว npx wrangler secret put AUTH_GOOGLE_ID
# ลิงก์: https://console.cloud.google.com/apis/credentials
# เปิดเผย: ลับ — production: npx wrangler secret put <ชื่อ> · ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ปุ่มล็อกอินปิดอยู่ | production → ล็อกอินไม่ได้
AUTH_GOOGLE_ID=

# --- AUTH_GOOGLE_SECRET (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: Client secret ของ OAuth client เดียวกัน
# หาจากไหน: หน้าเดียวกับ Client ID → Client secret แล้ว npx wrangler secret put AUTH_GOOGLE_SECRET (ห้ามใส่ในไฟล์ที่ commit)
# ลิงก์: https://console.cloud.google.com/apis/credentials
# เปิดเผย: ลับ — production: npx wrangler secret put <ชื่อ> · ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ปุ่มล็อกอินปิดอยู่ | production → ล็อกอินไม่ได้
AUTH_GOOGLE_SECRET=

# --- TURNSTILE_SECRET_KEY (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: คีย์ลับ Turnstile ตรวจว่าผู้ส่งฟอร์มเป็นคน
# หาจากไหน: Cloudflare → Turnstile → widget เดิม → Settings → เพิ่ม hostname ใหม่ (workers.dev / โดเมนจริง) → Secret key แล้ว npx wrangler secret put TURNSTILE_SECRET_KEY
# ลิงก์: https://dash.cloudflare.com/?to=/:account/turnstile
# เปิดเผย: ลับ — production: npx wrangler secret put <ชื่อ> · ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ใช้คีย์ทดสอบ (ผ่านเสมอ) | production → ส่งเสียงถึงสภาไม่ได้
TURNSTILE_SECRET_KEY=

# --- R2_ACCOUNT_ID (ไม่บังคับ) ---
# ใช้ทำอะไร: Account ID ของ Cloudflare ใช้สร้างลิงก์อัปโหลดตรงเข้า R2 (presigned)
# หาจากไหน: Cloudflare → R2 → Overview → Account ID แล้ว npx wrangler secret put R2_ACCOUNT_ID
# ลิงก์: https://dash.cloudflare.com/?to=/:account/r2/overview
# เปิดเผย: ลับ — production: npx wrangler secret put <ชื่อ> · ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → อัปโหลดผ่าน Worker แทน (ทำงานปกติ) | production → อัปโหลดผ่าน Worker แทน (ทำงานได้ ช้ากว่าเล็กน้อย)
R2_ACCOUNT_ID=

# --- R2_ACCESS_KEY_ID (ไม่บังคับ) ---
# ใช้ทำอะไร: Access Key ID ของ R2 API token (Object Read & Write เฉพาะ bucket utd-council-media)
# หาจากไหน: Cloudflare → R2 → Manage API tokens → Create API token → Object Read & Write → bucket utd-council-media แล้ว npx wrangler secret put R2_ACCESS_KEY_ID
# ลิงก์: https://dash.cloudflare.com/?to=/:account/r2/api-tokens
# เปิดเผย: ลับ — production: npx wrangler secret put <ชื่อ> · ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → อัปโหลดผ่าน Worker แทน | production → อัปโหลดผ่าน Worker แทน
R2_ACCESS_KEY_ID=

# --- R2_SECRET_ACCESS_KEY (ไม่บังคับ) ---
# ใช้ทำอะไร: Secret Access Key ของ token เดียวกัน
# หาจากไหน: แสดงครั้งเดียวตอนสร้าง token แล้ว npx wrangler secret put R2_SECRET_ACCESS_KEY
# ลิงก์: https://dash.cloudflare.com/?to=/:account/r2/api-tokens
# เปิดเผย: ลับ — production: npx wrangler secret put <ชื่อ> · ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → อัปโหลดผ่าน Worker แทน | production → อัปโหลดผ่าน Worker แทน
R2_SECRET_ACCESS_KEY=

# --- NEXT_PUBLIC_SITE_URL (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: ที่อยู่เว็บจริง (แผนที่เว็บ, metadata)
# หาจากไหน: URL หลัง deploy เช่น https://utd-student-council.<subdomain>.workers.dev หรือโดเมนจริง ใส่ใน wrangler.jsonc → vars
# ลิงก์: https://developers.cloudflare.com/workers/configuration/routing/
# เปิดเผย: ไม่ลับ — production ใส่ใน wrangler.jsonc → vars
# ถ้าไม่ใส่: dev → ใช้ http://localhost:3000 | production → ลิงก์ในแผนที่เว็บผิด
NEXT_PUBLIC_SITE_URL=http://localhost:8790

# --- NEXT_PUBLIC_TURNSTILE_SITE_KEY (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: Site key ของ Turnstile (แสดงในหน้าเว็บ)
# หาจากไหน: Cloudflare → Turnstile → widget เดิม → Site key ใส่ใน wrangler.jsonc → vars
# ลิงก์: https://dash.cloudflare.com/?to=/:account/turnstile
# เปิดเผย: ไม่ลับ — production ใส่ใน wrangler.jsonc → vars
# ถ้าไม่ใส่: dev → ไม่แสดง Turnstile | production → ส่งเสียงถึงสภาไม่ได้
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- ALLOWED_EMAIL_DOMAIN (ไม่บังคับ) ---
# ใช้ทำอะไร: โดเมนอีเมลที่ล็อกอินได้
# หาจากไหน: wrangler.jsonc → vars (ปกติ utd.ac.th)
# ลิงก์: https://admin.google.com/
# เปิดเผย: ไม่ลับ — production ใส่ใน wrangler.jsonc → vars
# ถ้าไม่ใส่: dev → ใช้ utd.ac.th | production → ใช้ utd.ac.th
ALLOWED_EMAIL_DOMAIN=utd.ac.th

# --- ADMIN_EMAILS (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: อีเมลผู้ดูแลระบบ (คั่นด้วยจุลภาค) ได้สิทธิ์ admin ทันทีและล็อกอินได้แม้อยู่นอกโดเมน
# หาจากไหน: wrangler.jsonc → vars แล้ว deploy ใหม่
# ลิงก์: https://myaccount.google.com/
# เปิดเผย: ไม่ลับ — production ใส่ใน wrangler.jsonc → vars
# ถ้าไม่ใส่: dev → ไม่มี admin | production → ไม่มี admin
ADMIN_EMAILS=admin1@utd.ac.th,someone@example.com
