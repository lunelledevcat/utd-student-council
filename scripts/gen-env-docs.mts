// Writes .env.example and the README section "ตั้งค่า env หาจากไหน" from one source:
// lib/env-spec.ts (names, public/secret, test-value rules, links) + messages/th.json setup.vars (Thai help).
// Run after changing either: npm run env:docs
import { readFileSync, writeFileSync } from "node:fs";
import { ENV_VARS } from "../lib/env-spec.ts";

const th = JSON.parse(readFileSync(new URL("../messages/th.json", import.meta.url), "utf8"));
const help = th.setup.vars as Record<string, { purpose: string; where: string; missingDev: string; missingProd: string }>;

// example values only — never real keys
const EXAMPLE: Record<string, string> = {
  APP_SECRET: "",
  AUTH_SECRET: "",
  AUTH_GOOGLE_ID: "",
  AUTH_GOOGLE_SECRET: "",
  TURNSTILE_SECRET_KEY: "",
  R2_ACCOUNT_ID: "",
  R2_ACCESS_KEY_ID: "",
  R2_SECRET_ACCESS_KEY: "",
  NEXT_PUBLIC_SITE_URL: "http://localhost:8790",
  NEXT_PUBLIC_TURNSTILE_SITE_KEY: "",
  ALLOWED_EMAIL_DOMAIN: "utd.ac.th",
  ADMIN_EMAILS: "admin1@utd.ac.th,someone@example.com",
};
const exposure = (pub: boolean) => (pub ? "ไม่ลับ — production ใส่ใน wrangler.jsonc → vars" : "ลับ — production: npx wrangler secret put <ชื่อ> · ห้าม commit / ห้ามส่งในแชท");

const env: string[] = [
  "# ==========================================================================================",
  "# เครื่องตัวเอง (npm run preview): คัดลอกไฟล์นี้เป็น .dev.vars แล้วใส่ค่า (.dev.vars ไม่ถูก commit)",
  "# Cloudflare (production): ค่าลับ -> npx wrangler secret put <ชื่อ> · ค่าไม่ลับ -> wrangler.jsonc vars แล้ว npm run deploy",
  "# ดูสถานะทุกค่า + bindings ได้ที่ /admin/setup (เฉพาะ admin, แสดงแค่สถานะ ไม่แสดงค่า)",
  "# ไฟล์นี้สร้างจาก lib/env-spec.ts + messages/th.json ด้วย `npm run env:docs` — แก้ที่ต้นทางแล้วรันใหม่",
  "# ==========================================================================================",
  "",
];
const md: string[] = [
  "<!-- env:start — generated by `npm run env:docs`, edit lib/env-spec.ts / messages/th.json instead -->",
  "## ตั้งค่า env หาจากไหน",
  "",
  "เครื่องตัวเอง: คัดลอก `.env.example` เป็น `.dev.vars` แล้วใส่ค่า · Cloudflare: ค่าลับใช้ `npx wrangler secret put <ชื่อ>`, ค่าไม่ลับอยู่ใน `wrangler.jsonc` → `vars`",
  "สถานะทุกค่า + bindings (D1/R2/KV/rate limit) ดูได้ที่ `/admin/setup` (admin เท่านั้น ไม่แสดงค่าจริง)",
  "",
];
for (const v of ENV_VARS) {
  const h = help[v.name];
  env.push(
    `# --- ${v.name} (${v.need === "required" ? "จำเป็นตอนใช้งานจริง" : "ไม่บังคับ"}) ---`,
    `# ใช้ทำอะไร: ${h.purpose}`,
    `# หาจากไหน: ${h.where}`,
    `# ลิงก์: ${v.url}`,
    `# เปิดเผย: ${exposure(v.public)}`,
    `# ถ้าไม่ใส่: dev → ${h.missingDev} | production → ${h.missingProd}`,
    `${v.name}=${EXAMPLE[v.name] ?? ""}`,
    "",
  );
  md.push(
    `### \`${v.name}\` — ${v.need === "required" ? "จำเป็นตอนใช้งานจริง" : "ไม่บังคับ"} · ${v.public ? "wrangler vars (ไม่ลับ)" : "**ลับ** — wrangler secret put"}`,
    `- **ใช้ทำอะไร:** ${h.purpose}`,
    `- **หาจากไหน:** ${h.where} (${v.url})`,
    `- **ถ้าไม่ใส่:** dev → ${h.missingDev} · production → ${h.missingProd}`,
    "",
  );
}
md.push("<!-- env:end -->");

writeFileSync(new URL("../.env.example", import.meta.url), env.join("\n"));
const readmeUrl = new URL("../README.md", import.meta.url);
const readme = readFileSync(readmeUrl, "utf8");
const block = md.join("\n");
const next = /<!-- env:start[\s\S]*?<!-- env:end -->/.test(readme)
  ? readme.replace(/<!-- env:start[\s\S]*?<!-- env:end -->/, block)
  : readme.replace(/## Environment \(`\.env\.example`\)[\s\S]*?(?=\n## )/, `${block}\n`);
writeFileSync(readmeUrl, next);
console.log(".env.example + README env section written");
