{
  "name": "utd-student-council",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "svg:optimize": "svgo -f public/illustrations -o public/illustrations --multipass",
    "test:auth": "node --no-warnings scripts/test-auth-rules.mts",
    "env:docs": "node --no-warnings scripts/gen-env-docs.mts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\"",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "security:check": "node scripts/security-check.mjs",
    "preview": "node scripts/cf.mjs preview",
    "deploy": "node scripts/cf.mjs deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:build": "node scripts/cf.mjs build"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@opennextjs/cloudflare": "^1.20.12",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "aws4fetch": "^1.0.20",
    "browser-image-compression": "^2.0.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "svgo": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.2"
  }
}
